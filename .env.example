# MGOSC SS DB Hub - environment variables
# Copy to .env.local for local development. On Vercel, add these in
# Project Settings -> Environment Variables. Never commit real values.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# The secret key (sb_secret_...) or legacy "service_role" key.
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Public URL of the site (used for certificate QR codes and auth emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random string used to hash visitor IPs for the registration rate limit.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=change-me-to-a-long-random-string

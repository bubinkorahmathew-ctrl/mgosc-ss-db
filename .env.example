# The StudentMasterDB - environment variables
# Copy to .env.local for local development. On Vercel, add these in
# Project Settings -> Environment Variables. Never commit real values.

# TiDB Cloud -> Connect: the connection string of the app's own database (never "sys").
# SERVER ONLY: never prefix with NEXT_PUBLIC_. Used by the app, drizzle-kit and the scripts.
DATABASE_URL=mysql://your-prefix.your-user:your-password@gateway01.your-region.prod.aws.tidbcloud.com:4000/studentmasterdb

# Signs and encrypts the sign-in cookie, and keys the sign-in lockout and form rate-limit tables.
# Generate one with:  npx auth secret   (or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
# Changing it signs everyone out.
AUTH_SECRET=

# Vercel Blob (private store) for signature images, and later bills and other uploads.
# Vercel -> Storage -> Blob -> create a store (private) and connect it to the project; Vercel adds this.
# Without it (e.g. local development) signatures are kept in the database instead.
BLOB_READ_WRITE_TOKEN=

# Public URL of the site (used for certificate QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, only for creating the first headmaster without a terminal (npm run super-admin).
# Remove the password once the account exists.
# SEED_HEADMASTER_EMAIL=
# SEED_HEADMASTER_NAME=
# SEED_HEADMASTER_PASSWORD=

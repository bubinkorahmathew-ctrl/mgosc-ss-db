# The StudentMasterDB - environment variables
# Copy to .env.local for local development. On Vercel, add these in
# Project Settings -> Environment Variables. Never commit real values.

# TiDB Cloud -> Connect. SERVER ONLY: never prefix with NEXT_PUBLIC_.
TIDB_HOST=gateway01.your-region.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your-prefix.your-user
TIDB_PASSWORD=your-password
# The app's own database, never "sys"
TIDB_DATABASE=studentmasterdb

# Public URL of the site (used for certificate QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random string used to hash IPs and emails for the registration and sign-in rate limits.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=change-me-to-a-long-random-string
